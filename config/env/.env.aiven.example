# Copia este archivo como config/local/.env.aiven y reemplaza los valores.
# No pegues estos secretos en chats ni los subas a Git.

AIVEN_DB_URL=mysql://avnadmin:CAMBIAR_PASSWORD@CAMBIAR_HOST.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Usa una de estas dos opciones para el CA de Aiven:
AIVEN_DB_SSL_CA_BASE64=CAMBIAR_CA_PEM_EN_BASE64
# AIVEN_DB_SSL_CA_FILE=aiven-ca.pem

# Opcional: si quieres forzar validacion TLS estricta.
AIVEN_DB_SSL_REJECT_UNAUTHORIZED=true
