# Copia este archivo como .env en la raiz del proyecto y reemplaza todos los valores.
# La aplicacion usa solo MySQL. No hay perfil demo con H2.

SERVER_PORT=8080
NODE_ENV=development
DEBUG=false

DB_URL=jdbc:mysql://localhost:3306/tornos_sa_cv?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tornos_sa_cv
DB_USER=tornos_app
DB_PASSWORD=CAMBIAR_password_largo_base_datos
MYSQL_ROOT_PASSWORD=CAMBIAR_root_password_largo
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_FILE=config/local/aiven-ca.pem

APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_Admin_2026!
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador
APP_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

APP_TOKEN_TTL_MINUTES=120
APP_TOKEN_RANDOM_BYTES=48
APP_BCRYPT_STRENGTH=12
APP_LOGIN_MAX_FAILED_ATTEMPTS=5
APP_LOGIN_RATE_LIMIT_MAX=10
APP_LOGIN_RATE_LIMIT_WINDOW_MS=900000

APP_UPLOAD_MAX_FILE_SIZE=25MB
APP_ALLOWED_ORIGINS=

# Herramienta IA de revision tecnica: npm run review:ai
OPENAI_API_KEY=CAMBIAR_openai_api_key
AI_REVIEW_OUTPUT=docs/ai-review-report.md
AI_REVIEW_MAX_CONTEXT_CHARS=120000
